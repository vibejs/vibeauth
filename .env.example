# Generate a local secret: pnpm exec auth secret. Never use this placeholder.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Basic: 127.0.0.1:5173; SaaS: localhost:5174. Exact external origin, without /api/auth.
BETTER_AUTH_URL=http://127.0.0.1:5173
TRUSTED_ORIGINS=http://127.0.0.1:5173
# Relative to the example working directory. Basic/SaaS defaults are separate .local files.
# DATABASE_PATH=.local/basic.sqlite
# PORT=3001
# Explicit loopback-only email transport. Links are written to .local/outbox.jsonl, never served.
VIBEAUTH_LOCAL_MAIL=1
# Production mail transport: POST { kind, email, url } to an HTTPS service you operate.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
# SaaS only; enable providers on both server and browser using public provider names.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
# Comma-separated configured providers. Public IDs only, never secrets.
VITE_SOCIAL_PROVIDERS=

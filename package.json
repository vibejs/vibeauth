{
  "name": "@usevibejs/auth",
  "version": "0.1.1",
  "description": "Authentication for vibe.js, powered by Better Auth.",
  "keywords": [
    "auth",
    "authentication",
    "better-auth",
    "sessions",
    "typescript",
    "vibejs"
  ],
  "homepage": "https://github.com/vibejs/vibeauth#readme",
  "bugs": {
    "url": "https://github.com/vibejs/vibeauth/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibeauth.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt && node scripts/format-vibe.ts --write",
    "test": "vitest run --project node --project dom",
    "test:coverage": "vitest run --coverage --project node --project dom --project browser",
    "test:browser": "vitest run --project browser",
    "test:integration": "vitest run --project integration --project e2e",
    "check": "oxfmt --check && node scripts/format-vibe.ts && pnpm typecheck && pnpm lint && pnpm test:coverage",
    "pack-check": "node scripts/pack-check.ts",
    "docs:build": "vitepress build docs",
    "examples:build": "pnpm --filter './examples/*' build",
    "examples:check": "pnpm --filter './examples/*' typecheck",
    "examples:verify": "node scripts/example-check.ts",
    "verify": "pnpm build && pnpm check && pnpm test:integration && pnpm examples:check && pnpm examples:build && pnpm examples:verify && pnpm docs:build && pnpm pack-check",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/utils": "catalog:",
    "@changesets/cli": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@usevibejs/compiler": "catalog:",
    "@usevibejs/contract": "catalog:",
    "@usevibejs/form": "catalog:",
    "@usevibejs/language-tools": "catalog:",
    "@usevibejs/query": "catalog:",
    "@usevibejs/server": "catalog:",
    "@usevibejs/ui": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "auth": "catalog:",
    "better-auth": "catalog:",
    "clsx": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "srvx": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@usevibejs/server": "^0.1.0",
    "@usevibejs/ui": "^0.1.0",
    "better-auth": "~1.7.13"
  },
  "peerDependenciesMeta": {
    "@usevibejs/server": {
      "optional": true
    },
    "@usevibejs/ui": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@11.18.0"
}

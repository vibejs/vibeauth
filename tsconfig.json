{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "experimentalDecorators": true
  },
  "include": ["src", "test", "*.config.ts"],
  "exclude": ["**/*.vibe.test.ts", "**/*.browser.test.ts"]
}

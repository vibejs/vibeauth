<script setup lang="ts">
import { computed } from '@usevibejs/ui';
import { useRoute, useRouter } from '@usevibejs/ui/router';
import { safeReturnURL } from '@usevibejs/auth/router';
import Credentials from '../../shared/components/Credentials.vibe';
const route = useRoute();
const router = useRouter();
const mode = computed(() => {
  const view = route.query.view;
  return view === 'signup' || view === 'forgot' || view === 'reset' ? view : 'login';
});
async function complete() {
  await router.replace(safeReturnURL(route.query.returnTo, '/dashboard'));
}
</script>
<template>
  <div class="mx-auto max-w-sm">
    <p class="mb-3 text-xs font-medium uppercase tracking-widest text-muted-foreground">
      Your account
    </p>
    <h1 class="mb-3 text-3xl font-semibold tracking-tight">
      {{
        mode === 'signup'
          ? 'Make yourself at home.'
          : mode === 'forgot'
            ? 'A fresh start.'
            : mode === 'reset'
              ? 'Choose a new password.'
              : 'Welcome back.'
      }}
    </h1>
    <p class="mb-8 text-sm leading-relaxed text-muted-foreground">
      {{
        mode === 'signup'
          ? 'Create your account. We’ll send an email to verify your address.'
          : mode === 'forgot'
            ? 'Enter your email address to request a recovery link.'
            : mode === 'reset'
              ? 'Set a strong password to secure your account.'
              : 'Sign in to manage your profile and account security.'
      }}
    </p>
    <Credentials :mode="mode" @complete="complete" />
    <nav
      class="mt-6 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm text-muted-foreground"
      aria-label="Account access"
    >
      <a href="/verify-email">Verify email</a><a v-if="mode !== 'login'" href="/login">Sign in</a
      ><a v-if="mode === 'login'" href="/login?view=signup">Create account</a
      ><a v-if="mode === 'login'" href="/login?view=forgot">Forgot password?</a>
    </nav>
  </div>
</template>

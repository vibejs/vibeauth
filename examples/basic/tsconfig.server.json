{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024"],
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "experimentalDecorators": true
  },
  "include": ["server", "../shared/server.ts", "../shared/config.ts", "../shared/contracts.ts"]
}

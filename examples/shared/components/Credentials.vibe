<script setup lang="ts">
import { ref, useId } from '@usevibejs/ui';
import { useField, useForm } from '@usevibejs/form';
import { useAuth } from '@usevibejs/auth';
import Button from '../ui/Button.vibe';
import Input from '../ui/Input.vibe';
import Field from '../ui/Field.vibe';
import FieldLabel from '../ui/FieldLabel.vibe';

const { mode = 'login' } = defineProps<{ mode?: 'login' | 'signup' | 'forgot' | 'reset' }>();
const emit = defineEmits<{ challenge: []; complete: [] }>();
const auth = useAuth();
const id = useId();
const show = ref(false);
const message = ref('');
const failed = ref(false);
const form = useForm({
  defaultValues: { name: '', email: '', password: '', confirm: '' },
  onSubmit: async ({ value }) => {
    message.value = '';
    failed.value = false;
    try {
      if (mode === 'forgot') {
        await auth.client.requestPasswordReset({
          email: value.email,
          redirectTo: `${location.origin}/?view=reset`,
        });
        message.value = 'If an account matches, a recovery email will arrive shortly.';
        return;
      }
      if (mode === 'reset') {
        if (value.password !== value.confirm) {
          failed.value = true;
          message.value = 'Passwords must match.';
          return;
        }
        const token = new URLSearchParams(location.search).get('token') ?? '';
        const result = await auth.client.resetPassword({ token, newPassword: value.password });
        if (result.error) {
          failed.value = true;
          message.value = 'This recovery link is invalid or expired. Request a new link.';
        } else {
          message.value = 'Password reset. You can now sign in.';
          form.reset();
        }
        return;
      }
      if (mode === 'signup') {
        if (value.password !== value.confirm) {
          failed.value = true;
          message.value = 'Passwords must match.';
          return;
        }
        await auth.client.signUp.email({
          name: value.name,
          email: value.email,
          password: value.password,
          callbackURL: location.origin,
        });
        message.value = 'Check your email to continue. If you already have an account, sign in.';
        form.reset();
        return;
      }
      const result = await auth.client.signIn.email({
        email: value.email,
        password: value.password,
      });
      if (result.error) {
        failed.value = true;
        message.value =
          'Unable to sign in. Check your details and email verification, then try again.';
        return;
      }
      if (result.data && 'twoFactorRedirect' in result.data) {
        form.reset();
        emit('challenge');
        return;
      }
      await auth.refreshSession();
      form.reset();
      emit('complete');
    } catch {
      failed.value = true;
      message.value = 'Unable to connect. Please try again.';
    }
  },
});
const name = useField(form, 'name');
const email = useField(form, 'email', {
  validators: {
    onBlur: ({ value }) => (value.includes('@') ? undefined : 'Enter your email address.'),
  },
});
const password = useField(form, 'password');
const confirm = useField(form, 'confirm');
</script>

<template>
  <form class="grid gap-5" @submit="form.submit" :aria-busy="form.isSubmitting">
    <Field v-if="mode === 'signup'"
      ><FieldLabel :for="id + '-name'">Full name</FieldLabel
      ><Input :id="id + '-name'" v-model="name.value" autocomplete="name" required
    /></Field>
    <Field v-if="mode !== 'reset'"
      ><FieldLabel :for="id + '-email'">Email address</FieldLabel
      ><Input
        :id="id + '-email'"
        v-model="email.value"
        type="email"
        autocomplete="username"
        required
        @blur="email.handleBlur"
        :aria-invalid="email.invalid || undefined"
        :aria-describedby="id + '-email-error'"
      />
      <p :id="id + '-email-error'" class="text-sm text-destructive">{{ email.error }}</p></Field
    >
    <Field v-if="mode !== 'forgot'">
      <div class="flex items-center justify-between">
        <FieldLabel :for="id + '-password'">Password</FieldLabel
        ><Button variant="ghost" size="xs" :aria-pressed="show" @click="show = !show"
          >{{ show ? 'Hide' : 'Show' }} password</Button
        >
      </div>
      <Input
        :id="id + '-password'"
        v-model="password.value"
        :type="show ? 'text' : 'password'"
        :autocomplete="mode === 'login' ? 'current-password' : 'new-password'"
        :minlength="mode === 'login' ? 1 : 12"
        :maxlength="128"
        required
      />
      <p v-if="mode !== 'login'" class="text-sm text-muted-foreground">
        Use at least 12 characters.
      </p>
    </Field>
    <Field v-if="mode === 'signup' || mode === 'reset'"
      ><FieldLabel :for="id + '-confirm'">Confirm password</FieldLabel
      ><Input
        :id="id + '-confirm'"
        v-model="confirm.value"
        type="password"
        autocomplete="new-password"
        required
    /></Field>
    <p
      v-if="message"
      :role="failed ? 'alert' : 'status'"
      class="text-sm leading-relaxed"
      :class="failed ? 'text-destructive' : 'text-muted-foreground'"
    >
      {{ message }}
    </p>
    <Button type="submit" :disabled="form.isSubmitting" class="w-full">{{
      form.isSubmitting
        ? 'Please wait…'
        : mode === 'signup'
          ? 'Create account'
          : mode === 'forgot'
            ? 'Send recovery email'
            : mode === 'reset'
              ? 'Reset password'
              : 'Sign in'
    }}</Button>
  </form>
</template>
